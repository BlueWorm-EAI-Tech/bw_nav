<?xml version="1.0"?>
<package format="3">
  <name>bw_planning_zones</name>
  <version>0.1.0</version>
  <description>Standalone polygon editing and planning-zone mask publishing</description>
  <maintainer email="dev@bw.local">BW Robotics</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>bw_interface</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-pil</exec_depend>
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>
