<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence name="NavigateWithTimeout">
      <Inverter name="NotExpired">
        <TimeExpired seconds="60"/>
      </Inverter>
      <RecoveryNode number_of_retries="-1" name="NavigateRecovery">
        <PipelineSequence name="NavigateWithReplanning">
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="3" name="ComputePathToPose">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
              <Sequence name="PlannerRecovery">
                <ClearEntireCostmap name="ClearGlobalCostmap-Planner" service_name="global_costmap/clear_entirely_global_costmap"/>
                <Wait wait_duration="2"/>
                <BackUp name="BackOutOfLethalStart" backup_dist="0.30" backup_speed="0.05"/>
                <ClearEntireCostmap name="ClearGlobalCostmap-AfterBackup" service_name="global_costmap/clear_entirely_global_costmap"/>
              </Sequence>
            </RecoveryNode>
          </RateController>
          <RecoveryNode number_of_retries="2" name="FollowPathWithRecovery">
            <FollowPath path="{path}" controller_id="FollowPath"/>
            <Sequence name="ObstacleClearAndWait">
              <ClearEntireCostmap name="ClearLocalCostmap-Obstacle" service_name="local_costmap/clear_entirely_local_costmap"/>
              <Wait wait_duration="3"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Obstacle" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
          </RecoveryNode>
        </PipelineSequence>
        <ReactiveFallback name="RecoveryFallback">
          <GoalUpdated/>
          <RoundRobin name="RecoveryActions">
            <Sequence name="ClearingActions">
              <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
            </Sequence>
            <Wait wait_duration="5"/>
          </RoundRobin>
        </ReactiveFallback>
      </RecoveryNode>
    </Sequence>
  </BehaviorTree>
</root>
